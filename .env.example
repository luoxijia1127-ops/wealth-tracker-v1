# 复制为 .env 后使用：cp .env.example .env
# 隐私政策（GitHub Pages）：推送 docs/ 并在仓库 Settings → Pages 选用 /docs 后生效

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://luoxijia1127-ops.github.io/wealth-tracker-v1/privacy.html
# 英文界面（语言为 English 或系统语言为英语）时优先加载；不设置则仍用上一行 URL
# EXPO_PUBLIC_PRIVACY_POLICY_URL_EN=https://luoxijia1127-ops.github.io/wealth-tracker-v1/privacy-en.html

# RevenueCat（iOS 公钥，见 RevenueCat 项目 → API keys → Apple App Store）
# Entitlement 请在 RC 中命名为 assetup_pro，并关联 App Store 订阅商品
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# 用户协议托管页（可选，与隐私政策相同用法）
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://你的用户名.github.io/仓库名/terms.html
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL_EN=https://你的用户名.github.io/仓库名/terms-en.html
