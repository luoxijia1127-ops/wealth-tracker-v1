# ═══════════════════════════════════════════════════════════════════════════
# 如何创建本地 .env（不是改业务代码，只是加配置文件）
#
# 方式 1（终端，在项目根目录执行）：
#   cp .env.example .env
#   再用编辑器打开 .env，按下面各节填写或取消注释。
#
# 方式 2（Cursor / VS Code）：
#   在左侧文件树里「项目根目录」（与 app/、package.json 同级）右键 → New File →
#   文件名输入：.env   （前面有点，无后缀）
#
# 方式 3（macOS 访达）：
#   在文件夹 wealth-tracker 里新建文本文件，命名为 .env（系统若隐藏扩展名，需确认
#   全名是 .env 而不是 .env.txt）。
#
# 说明：.env 已在 .gitignore，不会提交到 Git；改完后请重启 npx expo start。
# 所有 EXPO_PUBLIC_* 会在构建时内嵌到安装包，不要写 Twelve 的 apikey。
# ═══════════════════════════════════════════════════════════════════════════

# ── 隐私政策 ──────────────────────────────────────────────────────────────
# 在 GitHub 仓库 Settings → Pages → Deploy from /docs 后可用：
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://luoxijia1127-ops.github.io/wealth-tracker-v1/privacy.html
# 英文界面优先加载（不设置则回退到上方 URL）：
# EXPO_PUBLIC_PRIVACY_POLICY_URL_EN=https://luoxijia1127-ops.github.io/wealth-tracker-v1/privacy.html

# ── 用户协议 ──────────────────────────────────────────────────────────────
# 同 privacy，部署 docs/terms.html 后填写：
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://luoxijia1127-ops.github.io/wealth-tracker-v1/terms.html
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL_EN=https://luoxijia1127-ops.github.io/wealth-tracker-v1/terms.html

# ── RevenueCat ────────────────────────────────────────────────────────────
# Apple App Store 公钥（appl_…）：RevenueCat → Apps & providers → API keys → Apple 条目
# 用于：npx expo run:ios、development build、EAS/TestFlight、真机沙盒。勿在 Expo Go 使用 appl_。
# Entitlement 请命名为 assetup_pro，并关联 App Store 订阅商品与终身买断商品。
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
#
# Expo Go 专用：Test Store 公钥（test_…）。Expo Go 无原生 StoreKit，必须用 test_，否则会红屏报错。
# 可与 appl_ 同时保留：在 Expo Go 内会自动使用下一行；独立包使用上一行。
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY_TEST=test_你的TestStoreKey

# ── 国际行情（Twelve Data 经 Vercel 代理） ─────────────────────────────────
# 填写你的 Vercel 根地址（https://xxx.vercel.app），末尾不要加 /
EXPO_PUBLIC_MARKET_PROXY_ORIGIN=https://wealth-tracker-v1.vercel.app
# 正式走代理时不要写下面这行（写了会强制 OpenFIGI+Stooq）：
# EXPO_PUBLIC_INTL_PROVIDER=legacy
# 若 Vercel 设置了 PROXY_SHARED_SECRET，在此填写同一字符串（与 TWELVE_DATA_API_KEY 无关）：
# EXPO_PUBLIC_MARKET_PROXY_SECRET=
# Twelve 失败后再打 Stooq（默认关）：
# EXPO_PUBLIC_INTL_PRICE_FALLBACK_STOOQ=false

# ── 汇率接口（可选覆盖） ──────────────────────────────────────────────────
# 默认使用 Frankfurter（api.frankfurter.app），如需替换：
# EXPO_PUBLIC_FX_URL=https://你的自定义地址
